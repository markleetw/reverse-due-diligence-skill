{
  "correction_marker": "已移除或更正的主張",
  "stale_claims": [
    {
      "pattern": "132\\.5",
      "reason": "old reference price; canonical value is 126.5"
    }
  ],
  "resolved_claims": [
    {
      "pattern": "應收分期款[^。<]{0,30}查不到",
      "reason": "this item has since been obtained from a primary source"
    }
  ],
  "canonical_values": [
    {
      "value": "126.5",
      "label": "reference price",
      "min_occurrences": 1
    }
  ],
  "values": {
    "current_price": {
      "pattern": "current price:\\s*([\\d,.]+)",
      "type": "number"
    },
    "reference_price": {
      "pattern": "reference price:\\s*([\\d,.]+)",
      "type": "number"
    },
    "displayed_return": {
      "pattern": "displayed return:\\s*([+\\-−]?[\\d,.]+)%",
      "type": "percent"
    },
    "child_value": {
      "pattern": "child value:\\s*([\\d,.]+)",
      "type": "number"
    },
    "parent_value": {
      "pattern": "parent value:\\s*([\\d,.]+)",
      "type": "number"
    }
  },
  "assertions": [
    {
      "label": "displayed return matches current/reference price",
      "expression": "abs(displayed_return - (current_price / reference_price - 1)) < 0.001"
    },
    {
      "label": "child item must not exceed parent item",
      "expression": "child_value <= parent_value"
    }
  ],
  "arithmetic": [
    {
      "label": "legacy literal check remains supported",
      "expression": "abs(126.5 / 215 - 1 + 0.4116) < 0.001"
    }
  ]
}
